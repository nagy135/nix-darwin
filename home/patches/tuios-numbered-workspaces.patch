+package app
+
+import (
+	"testing"
+
+	"github.com/Gaurav-Gosain/tuios/internal/config"
+	"github.com/Gaurav-Gosain/tuios/internal/terminal"
+)
+
+func TestNumberedWorkspaceSkipsMissingSlotsWithAutomaticPanes(t *testing.T) {
+	m := &OS{
+		IsDaemonSession:  true,
+		NumWorkspaces:    9,
+		CurrentWorkspace: 1,
+		Windows:          []*terminal.Window{{Workspace: 1}},
+		UserConfig:       &config.UserConfig{},
+	}
+	m.UserConfig.Workspaces.NewWindowWhenEmpty = true
+	for _, target := range []int{3, 7, 9} {
+		if got := m.newWorkspaceSlot(target); got != target {
+			t.Errorf("shortcut to %d lands on %d", target, got)
+		}
+	}
+	m.UserConfig.Workspaces.NewWindowWhenEmpty = false
+	if got := m.newWorkspaceSlot(3); got != 2 {
+		t.Errorf("without automatic panes: got %d, want next slot 2", got)
+	}
+}
